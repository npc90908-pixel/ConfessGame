{
  "name": "a-journey-to-your-heart",
  "version": "1.1.0",
  "private": true,
  "description": "A Journey to Your Heart — an immersive 3D interactive romantic adventure built with Next.js, React Three Fiber and GSAP.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:audio": "python3 scripts/generate-audio.py",
    "assets:textures": "python3 scripts/generate-textures.py",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "framer-motion": "14.14.0",
    "gsap": "3.15.1",
    "howler": "2.2.4",
    "next": "16.4.6",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dancing-script": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@react-three/test-renderer": "^9.1.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/howler": "2.2.13",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "glslang-validator-prebuilt-predownloaded": "^0.0.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3"
  }
}
